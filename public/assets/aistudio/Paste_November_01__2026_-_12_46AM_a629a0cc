<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>كشف الحضور والمرتب</title>
<link href="https://fonts.googleapis.com/css2?family=Almarai&family=Amiri&family=Cairo&family=Tajawal&display=swap" rel="stylesheet">
<style>
:root{color-scheme:dark;--bg:#0b1020;--card:#141a2e;--tx:#eef0ff;--mu:#8b93b8;--bd:#232b47;--ac:#8b5cf6;--ac2:#22d3ee;--fri:#1a2140;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
*{box-sizing:border-box}html,body{margin:0}
